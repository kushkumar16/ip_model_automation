<mxfile host="app.diagrams.net"><diagram name="Reset during fio" id="Reset-during-fio"><mxGraphModel dx="760" dy="580" grid="1" gridSize="8" page="1" pageWidth="760" pageHeight="580" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Reset during fio: FW triggers, HW aborts all and acks, host sees RDY = 0" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#1F1E1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="712" height="28" as="geometry"/></mxCell><mxCell id="c3" value="Dashed = fio traffic · solid = controller reset" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#6B6A66;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="24" y="40" width="712" height="20" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Host (fio + driver)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8B6AE;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=12;fontSize=12;fontColor=#1F1E1D;" vertex="1" parent="1"><mxGeometry x="48" y="72" width="176" height="32" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=none;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#DDDBD5;strokeWidth=1.25;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="136" y="104" as="sourcePoint"/><mxPoint x="136" y="484" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="&lt;b&gt;NVMe IP&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8B6AE;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=12;fontSize=12;fontColor=#1F1E1D;" vertex="1" parent="1"><mxGeometry x="292" y="72" width="176" height="32" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=none;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#DDDBD5;strokeWid