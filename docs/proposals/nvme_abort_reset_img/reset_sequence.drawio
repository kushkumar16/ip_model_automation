l><mxCell id="c14" value="" style="endArrow=block;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#B8B6AE;strokeWidth=1.25;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="224" as="sourcePoint"/><mxPoint x="624" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="2. CTRL_RESET interrupt" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F1E1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="380" y="202" width="244" height="20" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=block;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#B8B6AE;strokeWidth=1.25;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="624" y="264" as="sourcePoint"/><mxPoint x="380" y="264" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="3. stop fetch, gate CQ, cancel all" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F1E1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="380" y="242" width="244" height="20" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=block;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#B8B6AE;strokeWidth=1.25;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="344" as="sourcePoint"/><mxPoint x="624" y="344" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="5. datapath idle (ack)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F1E1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="380" y="322" width="244" height="20" as="geometry"/></mxCell><mxCell id="c20" value="" style="endArrow=block;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#B8B6AE;strokeWidth=1.25;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="624" y="384" as="sourcePoint"/><mxPoint x="380" y="384" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="6. clear queues, CSTS.RDY = 0" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F1E1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="380" y="362" width="244" height="20" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=block;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#B8B6AE;strokeWidth=1.25;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="424" as="sourcePoint"/><mxPoint x="136" y="424" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="7. CSTS.RDY = 0 (reset done)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F1E1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="136" y="402" width="244" height="20" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;4. HW aborts all in-flight cmds&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3EDF9;strokeColor=#2B6FD6;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=12;fontSize=12;fontColor=#1F1E1D;" vertex="1" parent="1"><mxGeometry x="270.0" y="288" width="220" height="24" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;8. requeue in-flight I/O&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8B6AE;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=12;fontSize=12;fontColor=#1F1E1D;" vertex="1" parent="1"><mxGeometry x="36.0" y="448" width="200" height="24" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Commands dropped by reset get no CQE&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#6B6A66&#x27;&gt;The host learns of the reset from CSTS.RDY, re-enables, and resubmits. Between steps 1 and 3, HW may still post (see Risks).&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8B6AE;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;fontColor=#1F1E1D;" vertex="1" parent="1"><mxGeometry x="24" y="504" width="712" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
