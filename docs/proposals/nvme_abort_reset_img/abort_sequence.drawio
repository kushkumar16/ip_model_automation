lative="1" as="geometry"><mxPoint x="380" y="384" as="sourcePoint"/><mxPoint x="136" y="384" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="6. CQE CID 7: 0x07" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F1E1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="136" y="362" width="244" height="20" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=block;startArrow=none;endFill=1;startFill=1;html=1;strokeColor=#B8B6AE;strokeWidth=1.25;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="624" y="424" as="sourcePoint"/><mxPoint x="136" y="424" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="7. Abort CQE, DW0 = 0" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F1E1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="136" y="402" width="244" height="20" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;4. HW aborts CID 7&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3EDF9;strokeColor=#2B6FD6;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=12;fontSize=12;fontColor=#1F1E1D;" vertex="1" parent="1"><mxGeometry x="280.0" y="288" width="200" height="24" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Other fio I/O keeps completing in HW throughout&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#6B6A66&#x27;&gt;If CID 7 had already reached its CQE, step 4 reports TOO_LATE and the Abort returns DW0 = 1.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8B6AE;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;fontColor=#1F1E1D;" vertex="1" parent="1"><mxGeometry x="24" y="464" width="712" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
